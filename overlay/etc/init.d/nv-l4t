#!/sbin/openrc-run
# Port of NVIDIA's nv.service and nvpmodel.service.

description="NVIDIA L4T init (CPU governors, power model)"

depend() {
	after nv-l4t-early localmount mountall mountall.sh kmod eudev udev
}

start() {
	ebegin "Running NVIDIA L4T init (nv.sh)"
	/etc/systemd/nv.sh
	eend $?

	if [ -x /usr/sbin/nvpmodel ] && [ -e /etc/nvpmodel.conf ]; then
		ebegin "Applying nvpmodel power mode"
		/usr/sbin/nvpmodel -f /etc/nvpmodel.conf
		eend $?
	fi
}
